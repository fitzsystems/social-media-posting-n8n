    {
      "parameters": {
        "jsCode": "// 1. Get the data for the current item\nconst postForm = $input.item.json;\n\nlet isPostLengthOKForBluesky = true;\nlet isPostLengthOKForLinkedin = true;\nlet isPostLengthOKForMastodon = true;\n\nlet blueSkyFlag = 0;\nlet linkedInFlag = 0;\nlet mastodonFlag = 0;\n\nconst blueskyCharacterLimit = 300;\nconst linkedInCharacterLimit = 3000;\nconst mastodonCharacterLimit = 500;\n\n// checking for targetNetworks\nfor (let i = 0; i < postForm.TargetNetworks.length; i++) {\n  switch (postForm.TargetNetworks[i]) {\n    case \"Bluesky\":\n      blueSkyFlag = 1;\n      break;\n    \n    case \"LinkedIn\":\n      linkedInFlag = 1;\n      break;\n    \n    case \"Mastodon\":\n      mastodonFlag = 1;\n      break;\n    \n    default:\n      break;\n  }\n}\n\n// checking character lengths\nconst postLength = JSON.stringify(postForm.PostContent).length;\n\nif (blueSkyFlag == 1 && postLength > blueskyCharacterLimit) {\n  isPostLengthOKForBluesky = false;\n}\n\nif (linkedInFlag == 1 && postLength > linkedInCharacterLimit) {\n  isPostLengthOKForLinkedin = false;\n}\n\nif (mastodonFlag == 1 && postLength > mastodonCharacterLimit) {\n  isPostLengthOKForMastodon = false;\n}\n\n//is the PostType compatible with TargetNetworks\nlet isLinkedInArticleCompatible = true;\n\nif ((linkedInFlag == 0 && postForm.PostType == \"LinkedInArticle\") ||\n  (linkedInFlag == 1 && postForm.PostType == \"LinkedInArticle\" && postForm.URLinPost == \"\"))    {\n  isLinkedInArticleCompatible = false;\n}\n\n// Number of binaries\nlet numberOfBinaries\ntry {\n  numberOfBinaries = postForm.PostMedia.length;\n} catch (err) {numberOfBinaries = 0;}\n\n// Re-attach binaries from PostForm\nconst originalBinary = $('PostForm').item.binary;\n\n// 3. Return values\nreturn [\n  {\n    json: {\n      postLength : postLength,\n      isBlueskyContentLengthOK : isPostLengthOKForBluesky,\n      isLinkedinContentLengthOK : isPostLengthOKForLinkedin,\n      isMastodonContentLengthOK : isPostLengthOKForMastodon,\n      isPostTypeCorrect : isLinkedInArticleCompatible,\n      numberOfBinaries : numberOfBinaries\n    },\n    binary: originalBinary    // re-attach files from previous Node\n  }\n  \n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
