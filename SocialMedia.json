        "jsonBody": "={\n  \"repo\": \"{{ $('CreateBSkySession').item.json.handle }}\",\n  \"collection\": \"app.bsky.feed.post\",\n  \"record\": {{ \n    (() => {\n      const url = $('PostForm').item.json.URLinPost;\n      const hasUrl = url && url.trim() !== '';\n      \n      const record = {\n        \"$type\": \"app.bsky.feed.post\",\n        \"text\": $('PostForm').item.json['PostContent'],\n        \"createdAt\": DateTime.now().toISO(),\n        \"facets\": $json.facets ?? []\n      };\n      \n      if (hasUrl) {\n        record.embed = {\n          \"$type\": \"app.bsky.embed.external\",\n          \"external\": {\n            \"uri\": url.trim(),\n            \"title\": \"\",\n            \"description\": \"\"\n          }\n        };\n      }\n      \n      return JSON.stringify(record);\n    })()\n  }}\n}",
        "options": {}
